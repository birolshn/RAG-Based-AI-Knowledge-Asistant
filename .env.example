# Ortam değişkenleri (.env.example)
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# LLM Modeli (Ollama)
LLM_MODEL=llama3

# Embedding Modeli
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG Ayarları
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SIMILARITY_TOP_K=3
BM25_TOP_K=3
MEMORY_SIZE=5

# Google API Key (opsiyonel, ileride kullanılabilir)
# GOOGLE_API_KEY=your_key_here
